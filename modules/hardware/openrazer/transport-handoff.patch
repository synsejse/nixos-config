+    def _prepare_device(self, candidate):
+        """Release a shared serial's D-Bus path before the preferred transport registers it."""
+        if candidate.serial not in self._razer_devices:
+            return
+
+        previous = self._razer_devices[candidate.serial]
+        if candidate.CONNECTION_PRIORITY <= previous.dbus.CONNECTION_PRIORITY:
+            raise DeviceNotReady('Serial already exposed by the preferred transport')
+
+        self.logger.info('Switching %s from %s to %s', candidate.serial,
+                         previous.device_id, candidate._device_path)
+        # Save cached settings before retiring the now-inactive receiver. Its
+        # hardware DPI read may return zero or fail once the cable is connected.
+        self.write_persistence(self._persistence_file)
+        try:
+            previous.dbus.close(read_dpi=False)
+        except Exception:
+            self.logger.exception('Failed to close inactive transport %s', previous.device_id)
+        finally:
+            previous.dbus.remove_from_connection()
+            del self._razer_devices[previous.device_id]
+            self._deferred_devices.add(previous.device_id)
+            self.device_removed()
+
+    def _create_device(self, device_class, sys_name, sys_path, device_number, additional_interfaces):
+        try:
+            device = device_class(device_path=sys_path, device_number=device_number, config=self._config,
+                                  persistence=self._persistence, testing=self._test_dir is not None,
+                                  additional_interfaces=additional_interfaces, additional_methods=[],
+                                  unknown_serial_counter=self._unknown_serial_counter,
+                                  prepare_device=self._prepare_device)
+        except DeviceNotReady as error:
+            self.logger.debug('Deferring %s: %s', sys_name, error)
+            self._deferred_devices.add(sys_name)
+            return None
+        self._deferred_devices.discard(sys_name)
+        return device
