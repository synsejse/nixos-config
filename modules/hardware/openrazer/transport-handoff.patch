+    def _collecting_udev_method(self):
+        # Serialize additions, removals and receiver retries. D-Bus paths must
+        # never be registered while another hotplug callback is retiring them.
+        while True:
+            time.sleep(2)  # let udev settle and receivers reconnect
+            with self._udev_event_lock:
+                events = self._collecting_udev_devices
+                self._collecting_udev_devices = []
+
+            removals = [d for d in events if d is not None and d.action == 'remove']
+            additions = sorted((d for d in events if d is not None and d.action == 'add'),
+                               key=lambda d: d.sys_path, reverse=True)
+            for device in removals + additions:
+                try:
+                    if device.action == 'remove':
+                        self._remove_device(device)
+                    else:
+                        self._add_device(device)
+                except Exception:  # A bad device must not disable all future hotplug.
+                    self.logger.exception('Failed to process %s for %s', device.action, device.sys_name)
+
+            if removals or None in events:
+                try:
+                    self._load_devices()
+                except Exception:
+                    self.logger.exception('Failed to rescan connected devices')
+
+            with self._udev_event_lock:
+                if not self._collecting_udev_devices:
+                    self._collecting_udev = False
+                    return

