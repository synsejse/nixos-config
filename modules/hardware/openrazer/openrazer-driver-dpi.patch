# OpenRazer 3.12.4: validate DPI/stage responses and propagate failed writes.
# Applied after the local HyperPolling and power patches. No automatic write retries.
--- a/driver/razermouse_driver.c
+++ b/driver/razermouse_driver.c
@@ -2307,6 +2307,7 @@
     struct razer_mouse_device *device = dev_get_drvdata(dev);
     struct razer_report request = {0};
     struct razer_report response = {0};
+    int err;
     unsigned short dpi_x;
     unsigned short dpi_y;
     unsigned char dpi_x_byte;
@@ -2520,7 +2521,13 @@
         return -EINVAL;
     }
 
-    razer_send_payload(device, &request, &response);
+    err = razer_send_payload(device, &request, &response);
+    if (err)
+        return err;
+    if (response.status == RAZER_CMD_BUSY)
+        return -EAGAIN;
+    if (response.status != RAZER_CMD_SUCCESSFUL)
+        return -EIO;
 
     return count;
 }
@@ -2535,6 +2542,7 @@
     struct razer_mouse_device *device = dev_get_drvdata(dev);
     struct razer_report request = {0};
