-                  response_report->data_size)) {
-        /* Sanitize the value since at the moment callers don't respect the return code */
-        response_report->data_size = ARRAY_SIZE(response_report->arguments);
-        return -EINVAL;
-    }
-
-    return result;
+    return retval;
 }

