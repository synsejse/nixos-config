-        break;
-    case RAZER_CMD_FAILURE:
-        print_erroneous_report(response, "razermouse", "Command failed");
-        return -EIO;
-    case RAZER_CMD_NOT_SUPPORTED:
-        print_erroneous_report(response, "razermouse", "Command not supported");
