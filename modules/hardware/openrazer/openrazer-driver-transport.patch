-    err = razer_get_report(device->usb_dev, request, response);
+    for (attempt = 0; attempt < max_attempts; attempt++) {
+        err = razer_get_report(device->usb_dev, request, response);
+        if (err) {
+            error_message = "USB transfer failed";
+            break;
+        }
+
+        if (response->remaining_packets != request->remaining_packets ||
+            response->command_class != request->command_class ||
+            response->command_id.id != request->command_id.id ||
+            (retry_read && (response->transaction_id.id != request->transaction_id.id ||
+                            response->protocol_type != request->protocol_type))) {
+            error_message = "Response doesn't match request";
+            err = -EIO;
+        } else if (response->status == RAZER_CMD_SUCCESSFUL) {
+            /* A matching header alone does not exclude a torn response. */
+            if (!retry_read || response->crc == razer_calculate_crc(response)) {
+                err = 0;
+                break;
+            }
+            error_message = "Invalid response checksum";
+            err = -EBADMSG;
+        } else if (response->status == RAZER_CMD_BUSY) {
+            /* Preserve the existing write/other-device busy handling. */
+            if (!retry_read) {
+                err = 0;
+                break;
+            }
+            error_message = "Device is busy";
+            err = -EAGAIN;
+        } else {
+            switch (response->status) {
+            case RAZER_CMD_FAILURE:
+                error_message = "Command failed";
+                err = -EIO;
+                break;
+            case RAZER_CMD_NOT_SUPPORTED:
+                error_message = "Command not supported";
+                err = -EOPNOTSUPP;
+                break;
+            case RAZER_CMD_TIMEOUT:
+                error_message = "Command timed out";
+                err = -ETIMEDOUT;
