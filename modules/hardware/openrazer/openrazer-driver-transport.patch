-/**
- * Function to send to device, get response, and actually check the response
+/*
+ * The 00c3 receiver can return a stale or partially updated feature report.
+ * Captures show that waiting longer or repeating GET_REPORT does not recover it,
+ * but resending these read-only queries does. Never replay settings writes.
+ */
+static bool razer_retryable_receiver_read(struct razer_mouse_device *device, struct razer_report *request)
+{
+    if (device->usb_pid != USB_DEVICE_ID_RAZER_DEATHADDER_V3_PRO_WIRELESS_ALT)
+        return false;
+
+    if (request->command_class == 0x04)
+        return request->command_id.id == 0x85 || request->command_id.id == 0x86;
+
+    if (request->command_class == 0x07)
+        return request->command_id.id == 0x80 || request->command_id.id == 0x81 ||
+               request->command_id.id == 0x83 || request->command_id.id == 0x84;
+
+    return false;
+}
+
+/**
+ * Send a command and validate its response while holding the device lock.
  */
 static int razer_send_payload(struct razer_mouse_device *device, struct razer_report *request, struct razer_report *response)
 {
-    int err;
+    bool retry_read = razer_retryable_receiver_read(device, request);
+    unsigned int max_attempts = retry_read ? 3 : 1;
