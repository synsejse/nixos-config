+/*
+ * DeathAdder V3 Pro 00c3 routes both extended polling writes through 0x1f.
+ * 0xff times out on the second write. Serialize the pair and verify each ack;
+ * a failed second command can leave a partially applied setting, so report the
+ * error and never automatically replay or undo either write.
+ */
+static int razer_set_receiver_poll_rate(struct razer_mouse_device *device, unsigned short polling_rate)
+{
+    struct razer_report request;
+    struct razer_report response;
+    unsigned int mode;
+    int err = 0;
+
+    mutex_lock(&device->lock);
+    for (mode = 0; mode < 2; mode++) {
+        request = razer_chroma_misc_set_polling_rate2(polling_rate, mode);
+        request.transaction_id.id = 0x1f;
+        err = razer_send_payload_locked(device, &request, &response);
+        if (err)
+            break;
+        if (response.status != RAZER_CMD_SUCCESSFUL) {
+            err = response.status == RAZER_CMD_BUSY ? -EAGAIN : -EIO;
+            break;
+        }
+        if (response.transaction_id.id != request.transaction_id.id ||
+            response.protocol_type != request.protocol_type ||
+            response.data_size < 2 || response.arguments[0] != mode ||
+            response.arguments[1] != request.arguments[1]) {
+            err = -EIO;
+            break;
+        }
+        if (response.crc != razer_calculate_crc(&response)) {
+            err = -EBADMSG;
+            break;
+        }
+    }
+    mutex_unlock(&device->lock);
+    return err;
+}
