configuration {
  modes: "combi,window,drun";
  combi-modes: [ window, drun ];
  combi-hide-mode-prefix: true;
  show-icons: true;
  icon-theme: "breeze-dark";
  matching: "fuzzy";
  font: "Open Sans 11";
  terminal: "ghostty";
  window-format: "{t}";
  drun-display-format: "{name}";
  kb-cancel: "Escape,Super_L,Super_R";
  kb-select-1: "Control+1";
  kb-select-2: "Control+2";
  kb-select-3: "Control+3";
  kb-select-4: "Control+4";
  kb-select-5: "Control+5";
  kb-select-6: "Control+6";
  kb-select-7: "Control+7";
  kb-select-8: "Control+8";
  kb-select-9: "Control+9";
}
@theme "/dev/null"
* {
  background-color: transparent;
  text-color: #e7e7e7;
  border-color: #434343;
  padding: 0;
  margin: 0;
}
window {
  width: 680px;
  location: center;
  anchor: center;
  background-color: #1b1b1b;
  border: 1px;
  border-radius: 18px;
}
mainbox { padding: 20px; spacing: 12px; children: [ inputbar, listview, textbox-hint ]; }
inputbar {
  children: [ entry ];
  padding: 8px 14px;
  border: 2px;
  border-radius: 24px;
  border-color: #e79cfe;
}
entry { placeholder: "Search apps and open windows…"; placeholder-color: #a0a0a0; }
listview {
  lines: 7;
  columns: 1;
  fixed-height: true;
  spacing: 4px;
  scrollbar: false;
  border: 0;
  padding: 0;
}
element {
  padding: 12px;
  spacing: 12px;
  border: 0;
  border-radius: 9px;
  children: [ element-icon, element-text ];
}
element normal.normal, element alternate.normal { background-color: transparent; }
element selected.normal { background-color: #303030; }
element-icon { size: 28px; }
element-text { vertical-align: 0.5; highlight: bold underline #e79cfe; text-color: inherit; }
textbox-hint {
  expand: false;
  str: "Enter  Open / switch     Ctrl+1-9  Quick select     Esc  Close";
  text-color: #a0a0a0;
  font: "Open Sans 9";
}
message { border: 0; padding: 8px; }
